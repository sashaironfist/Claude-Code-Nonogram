{
  "manifest_version": 3,
  "name": "AI Bridge — Claude ↔ ChatGPT",
  "version": "1.0.0",
  "description": "One-click transfer of AI responses between Claude and ChatGPT",
  "permissions": ["activeTab", "storage"],
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
